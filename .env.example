# Event Horizon — environment template
# Copy to .env in repo root: cp .env.example .env
# NEVER commit .env (listed in .gitignore).
#
# make deploy / docker compose use: --env-file .env

# =============================================================================
# Auth & security (required for production-like runs)
# =============================================================================
# Generate: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_EXP_HOURS=24

# =============================================================================
# PostgreSQL — shared dev credentials (all service DBs in compose)
# =============================================================================
POSTGRES_USER=eventhorizon
POSTGRES_PASSWORD=CHANGE_ME_postgres_dev_password

# =============================================================================
# Patroni pilot (optional — deployments/patroni/auth/)
# =============================================================================
PATRONI_SUPERUSER_USERNAME=postgres
PATRONI_SUPERUSER_PASSWORD=CHANGE_ME_patroni_superuser
PATRONI_REPLICATION_USERNAME=replicator
PATRONI_REPLICATION_PASSWORD=CHANGE_ME_patroni_replication
PATRONI_APP_USERNAME=eventhorizon
PATRONI_APP_PASSWORD=CHANGE_ME_patroni_app

# =============================================================================
# Observability (local defaults)
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_admin

# =============================================================================
# Payment / integrations (optional)
# =============================================================================
PAYMENT_WEBHOOK_SECRET=
BOOSTY_CHECKOUT_URL=https://boosty.to/eastwesser
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =============================================================================
# CI/CD & delivery (optional — do not commit real tokens)
# =============================================================================
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
# ANSIBLE_BECOME_PASSWORD=
